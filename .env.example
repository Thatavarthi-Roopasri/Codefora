# Copy this file to the environment system used by your host.
# Do not commit real secret values.

# Backend server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Local-only backend mode. Set true for local mock JSON development.
# Leave unset or false for production.
CODEFORA_LOCAL_MODE=true
CODEFORA_DATA_DIR=

# Production backend Firebase Admin
# In production, set NODE_ENV=production and CODEFORA_REQUIRE_FIREBASE=true.
# The backend will fail startup if these are missing or CODEFORA_LOCAL_MODE=true.
CODEFORA_REQUIRE_FIREBASE=false
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\firebase-service-account.json

# Optional backend integrations
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_KEY=your-judge0-api-key
JUDGE0_HOST=judge0-ce.p.rapidapi.com
PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Real verification script only. Use a fresh ID token from a signed-in Firebase user.
E2E_API_URL=http://127.0.0.1:5000
E2E_FRONTEND_URL=http://127.0.0.1:3000
CODEFORA_VERIFY_USER_ID=your-firebase-user-uid
CODEFORA_VERIFY_ID_TOKEN=your-firebase-id-token

# Frontend API and Firebase client config
VITE_API_URL=http://localhost:5000
VITE_USE_REMOTE_API=false
VITE_FIREBASE_API_KEY=your-client-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
